<% content_for :title, "ScreenJail 管理" %>
<% content_for :header_actions do %>
  <div class="cluster">
    <%= button_to "全員ロック", lock_all_admin_devices_path, class: "button button--primary" %>
    <%= button_to "全員解除", unlock_all_admin_devices_path, class: "button" %>
  </div>
<% end %>

<%# 全員操作: ロック画面のタイトルとボタン構成を一括設定 %>
<details class="card bulk-lock-screen">
  <summary>ロック画面を全員に一括設定</summary>
  <%= form_with url: update_lock_screen_admin_devices_path, method: :post, class: "cluster" do %>
    <%= text_field_tag :lock_title, "LOCKED", placeholder: "タイトル" %>
    <%= select_tag :buttons_preset, options_for_select(
          [["休憩＋トイレ", "break_toilet"], ["休憩＋その他", "break_custom"], ["トイレのみ", "toilet_only"], ["ボタンなし", "none"]],
          "break_toilet") %>
    <%= submit_tag "全員に適用", class: "button" %>
  <% end %>
</details>

<%= turbo_stream_from "admin" %>

<%= render "admin/pending_banner" %>

<div class="layout-2col">
  <section class="stack">
    <h2>端末（<%= @devices.size %>）</h2>
    <% if @devices.empty? %>
      <p class="muted">まだ端末がありません。Android アプリから参加すると、ここに出ます。</p>
    <% end %>
    <div class="device-grid" id="devices">
      <%= render partial: "admin/device", collection: @devices, as: :device %>
    </div>
  </section>

  <aside class="stack">
    <div id="ranking"><%= render "admin/ranking" %></div>

    <div class="card stack">
      <h2>ログ</h2>
      <div class="events" id="events">
        <%= render partial: "admin/event", collection: @events, as: :event %>
      </div>
    </div>
  </aside>
</div>
