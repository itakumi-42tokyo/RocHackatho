<%= tag.div id: dom_id(device), class: "card device-card stack #{'device-card--locked' if device.effective_locked?}" do %>
  <div class="row">
    <h3><%= device.name %> <span class="muted device-id">#<%= device.id %></span></h3>
    <span class="cluster">
      <% if device.escaped? %><span class="badge badge--escaped">🚨 脱獄中</span><% end %>
      <span class="badge badge--<%= device.status %>"><%= device.status %></span>
    </span>
  </div>
  <% if device.client_id.present? %>
    <div class="muted device-client">端末ID: <%= device.client_id.to_s.last(6) %></div>
  <% end %>

  <div class="row">
    <% if device.effective_locked? %>
      <span>🔒 ロック中</span>
    <% elsif device.locked? && device.unlock_remaining_seconds.positive? %>
      <span>⏳ 一時解除中（残り <%= (device.unlock_remaining_seconds / 60.0).ceil %> 分）</span>
    <% else %>
      <span>🔓 解除</span>
    <% end %>
    <span class="muted">脱獄 <%= device.escape_count %> 回</span>
  </div>

  <%# 一時解除中だけ、延長と今すぐ再ロックを出す %>
  <% if device.locked? && device.unlock_remaining_seconds.positive? %>
    <div class="cluster">
      <%= button_to "+5分", extend_unlock_admin_device_path(device, minutes: 5), method: :patch, class: "button" %>
      <%= button_to "+10分", extend_unlock_admin_device_path(device, minutes: 10), method: :patch, class: "button" %>
      <%= button_to "今すぐ再ロック", relock_admin_device_path(device), method: :patch, class: "button button--primary" %>
    </div>
  <% end %>

  <%# 承認待ちのリクエストがあれば、承認・却下の操作を出す %>
  <% if (req = device.open_break_request) %>
    <div class="card request-box stack">
      <div class="row">
        <strong>📨 <%= req.label %></strong>
        <span class="muted"><%= time_ago_in_words(req.created_at) %>前</span>
      </div>

      <%= form_with url: approve_admin_break_request_path(req), method: :patch, class: "cluster request-approve" do %>
        <%= label_tag "minutes_#{req.id}", "解除", class: "muted" %>
        <%= select_tag :minutes,
              options_for_select(BreakRequest::PRESET_MINUTES.map { |m| ["#{m}分", m] }, req.default_minutes),
              id: "minutes_#{req.id}" %>
        <%# morph でも入力中のテキストを消さない %>
        <%= text_field_tag :reply, nil, placeholder: "ひとこと（任意）", class: "request-reply",
              id: "approve_reply_#{req.id}", data: { turbo_permanent: true } %>
        <%= submit_tag "承認", class: "button button--primary" %>
      <% end %>

      <%= form_with url: deny_admin_break_request_path(req), method: :patch, class: "cluster request-deny" do %>
        <%= text_field_tag :reply, nil, placeholder: "却下の理由（任意）", class: "request-reply",
              id: "deny_reply_#{req.id}", data: { turbo_permanent: true } %>
        <%= submit_tag "却下", class: "button" %>
      <% end %>
    </div>
  <% end %>

  <%= form_with scope: :device, url: admin_device_path(device), method: :patch, class: "stack" do |f| %>
    <label class="cluster">
      強さ
      <%= f.select :lock_mode, [["重ね表示だけ(弱)", "overlay"], ["画面固定(中)", "pinning"], ["固定＋重ね(強)", "full"]], { selected: device.lock_mode } %>
    </label>

    <label class="opacity-row">
      濃さ
      <%= f.range_field :opacity, in: 0..100, step: 5, value: device.opacity %>
      <span><%= device.opacity %>%</span>
    </label>

    <%= f.text_field :lock_message, value: device.lock_message, placeholder: "ロック画面の文言（任意）",
          id: "lock_message_#{device.id}", data: { turbo_permanent: true } %>

    <div class="cluster">
      <%= f.submit "ロック", name: "commit_action", value: "lock", class: "button button--primary" %>
      <%= f.submit "解除", name: "commit_action", value: "unlock", class: "button" %>
    </div>
  <% end %>
<% end %>
